generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum RoomStatus {
  WAITING
  PLAYING
  FINISHED
}

enum GameStatus {
  PLAYING
  FINISHED
}

enum OAuthProvider {
  GOOGLE
  DISCORD
  TWITCH
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String

  role         UserRole @default(USER)
  isBlocked    Boolean  @default(false)

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile Profile?
  sessions Session[]

  oauthAccounts OAuthAccount[]

  roomMembers RoomMember[]
  hostedRooms Room[] @relation("RoomHost")
  gamePlayers GamePlayer[]
  wonGames    Game[] @relation("UserWonGames")
  wonResults  GameResult[] @relation("UserWonResults")

  newsArticles News[] @relation("NewsAuthor")

  sentFriendRequests      Friendship[]     @relation("FriendshipRequester")
  receivedFriendRequests  Friendship[]     @relation("FriendshipAddressee")

  sentInvitations         RoomInvitation[] @relation("InvitationInviter")
  receivedInvitations     RoomInvitation[] @relation("InvitationInvitee")
}

model Profile {
  id        String   @id @default(cuid())
  userId    String   @unique
  nickname  String   @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime?

  ipAddress String?
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model OAuthAccount {
  id             String        @id @default(cuid())
  userId         String
  provider       OAuthProvider
  providerUserId String
  email          String?
  createdAt      DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
}

model Room {
  id          String     @id @default(cuid())
  code        String     @unique
  hostUserId  String
  status      RoomStatus @default(WAITING)
  maxPlayers  Int        @default(6)
  createdAt   DateTime   @default(now())
  startedAt   DateTime?
  finishedAt  DateTime?

  host User @relation("RoomHost", fields: [hostUserId], references: [id])

  members     RoomMember[]
  games       Game[]
  invitations RoomInvitation[]

  @@index([status, createdAt])
  @@index([hostUserId])
}

model RoomMember {
  roomId   String
  userId   String   @unique
  isReady  Boolean  @default(false)
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([roomId, userId])
}

model Game {
  id         String     @id @default(cuid())
  roomId     String
  status     GameStatus @default(PLAYING)
  winnerId   String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?

  state Json?

  room   Room   @relation(fields: [roomId], references: [id], onDelete: Cascade)
  winner User?  @relation("UserWonGames", fields: [winnerId], references: [id])

  players    GamePlayer[]
  gameResult GameResult?

  @@index([roomId])
}

model GamePlayer {
  gameId    String
  userId    String
  finalSoul Int?
  place     Int?

  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@id([gameId, userId])
}

model GameResult {
  id        String   @id @default(cuid())
  gameId    String   @unique
  winnerId  String?
  createdAt DateTime @default(now())

  game   Game   @relation(fields: [gameId], references: [id], onDelete: Cascade)
  winner User?  @relation("UserWonResults", fields: [winnerId], references: [id])
}

model Character {
  id                 String   @id @default(cuid())
  slug               String   @unique
  name               String

  image              String?

  farmila            Int
  perekup            Int
  tuller             Int

  abilityId          String?
  abilityName        String?
  abilityDescription String?

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([slug])
}

model EventCard {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String

  image       String?

  farmila     Int
  perekup     Int
  tuller      Int

  mainStat    String

  reward      Int
  riskReward  Int

  description String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([slug])
}

model News {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  body        String

  isPublished Boolean   @default(false)
  publishedAt DateTime?

  authorId    String

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  author User @relation("NewsAuthor", fields: [authorId], references: [id])

  @@index([isPublished, publishedAt])
}

model Friendship {
  id          String           @id @default(cuid())
  requesterId String
  addresseeId String
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  readAt      DateTime?

  requester User @relation("FriendshipRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendshipAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model RoomInvitation {
  id          String           @id @default(cuid())
  roomId      String
  inviterId   String
  inviteeId   String
  status      InvitationStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  expiresAt   DateTime
  readAt      DateTime?

  room    Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  inviter User @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)
  invitee User @relation("InvitationInvitee", fields: [inviteeId], references: [id], onDelete: Cascade)

  @@index([inviteeId, status])
  @@index([roomId])
}