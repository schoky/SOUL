{
	"name": "soul",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm",
	"scripts": {
		"dev": "pnpm --parallel --filter @soul/client --filter @soul/server dev",
		"dev:client": "pnpm --filter @soul/client dev",
		"dev:server": "pnpm --filter @soul/server dev",
		"db:studio": "pnpm --filter @soul/database exec prisma studio --port 5555",
		"build": "pnpm -r build",
		"typecheck": "pnpm -r typecheck"
	},
	"devDependencies": {
		"@schoky/prettier": "^1.1.7",
		"prettier-plugin-prisma": "^5.0.0"
	}
}